# MiniMax (China site, OpenAI-compatible). Leave empty to use template triage only.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3
# MiniMax-M3 runs with thinking disabled unless this is "adaptive".
MINIMAX_THINKING=
# Set to 0 to force template triage even when MINIMAX_API_KEY is set.
DISPUTE_STEWARD_LLM=1
LLM_TIMEOUT_MS=60000

# PayPal Developer sandbox (optional). Default mode is mock — demo runs without these.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
